# Copy to .env and fill in real values. Never commit .env.
#
# Three separate Anthropic workspaces are required (see LLM-TRUNK.md > Keys).
# Only the "routed-client" key belongs here. The builder key (used by the
# Claude Code session that writes this repo) and the unrouted-baseline key
# must live elsewhere (a different shell/profile), never in this file.

# LiteLLM proxy admin auth
LITELLM_MASTER_KEY=

# Anthropic workspace: "llm-trunk routed" — LiteLLM uses this to call
# api.anthropic.com on behalf of tagged/untagged requests.
ANTHROPIC_API_KEY=

# Postgres (spend tracking, virtual keys). This gets interpolated unescaped
# into a postgresql:// URL in docker-compose.yml, so the password must be
# URL-safe — use `openssl rand -hex 24`, not -base64 (which can emit
# "/", "+", "=" and silently break the connection string).
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
