# Copy to .env and fill in real values. Never commit .env.
#
# Only the gateway's own Anthropic key belongs here. A dedicated Anthropic
# workspace for it makes the routed spend easy to track; any other key you
# use (e.g. your own Claude Code's) stays out of this file.

# LiteLLM proxy admin auth
LITELLM_MASTER_KEY=

# LiteLLM uses this to call api.anthropic.com for every routed request.
ANTHROPIC_API_KEY=

# Postgres (spend tracking, virtual keys). This gets interpolated unescaped
# into a postgresql:// URL in docker-compose.yml, so the password must be
# URL-safe — use `openssl rand -hex 24`, not -base64 (which can emit
# "/", "+", "=" and silently break the connection string).
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
